diff --git a/test/login-logging.test.js b/test/login-logging.test.js
new file mode 100644
index 0000000..78da566
--- /dev/null
+++ b/test/login-logging.test.js
@@ -0,0 +1,108 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createServer } = require('../src/server.js');
+const { createUserStore } = require('../src/users.js');
+const { USERS } = require('./fixtures/users.js');
+const { listen } = require('./helpers.js');
+
+const [ALICE, BOB] = USERS;
+
+// src/login.js is loaded lazily so a missing module fails an assertion instead of the whole file.
+function loadLogin() {
+  try {
+    return require('../src/login.js');
+  } catch (err) {
+    if (err.code === 'MODULE_NOT_FOUND') return {};
+    throw err;
+  }
+}
+
+async function postRaw(url, body) {
+  const res = await fetch(`${url}/login`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body,
+  });
+  return { status: res.status, text: await res.text() };
+}
+
+const postLogin = (url, body) => postRaw(url, JSON.stringify(body));
+
+// Records every console call and stdout/stderr write while still forwarding to the original.
+async function recordOutput(fn) {
+  const recorded = [];
+  const methods = ['log', 'info', 'warn', 'error', 'debug'];
+  const saved = methods.map(m => console[m]);
+  const savedOut = process.stdout.write;
+  const savedErr = process.stderr.write;
+  const capture = args => recorded.push(args.map(a => (typeof a === 'string' ? a : Buffer.isBuffer(a) ? a.toString('utf8') : String(a))).join(' '));
+  methods.forEach((m, i) => {
+    console[m] = (...args) => {
+      capture(args);
+      return saved[i].apply(console, args);
+    };
+  });
+  process.stdout.write = function (...args) {
+    capture(args);
+    return savedOut.apply(this, args);
+  };
+  process.stderr.write = function (...args) {
+    capture(args);
+    return savedErr.apply(this, args);
+  };
+  try {
+    await fn();
+  } finally {
+    methods.forEach((m, i) => {
+      console[m] = saved[i];
+    });
+    process.stdout.write = savedOut;
+    process.stderr.write = savedErr;
+  }
+  return recorded.join('\n');
+}
+
+test('no password or token reaches the logs on any login path', async () => {
+  const { createVerificationGate } = loadLogin();
+  assert.equal(typeof createVerificationGate, 'function', 'src/login.js exports createVerificationGate');
+  const secrets = [ALICE.password, 'wrong-password-logged', 'unknown-user-password', 'bob-guess-password', 'malformed-body-password', 'busy-server-password'];
+  const tokens = [];
+  const srv = await listen(createServer({ users: createUserStore(USERS) }));
+  const busy = await listen(createServer({ users: createUserStore(USERS), gate: createVerificationGate({ maxActive: 0, maxQueued: 0 }) }));
+  try {
+    const output = await recordOutput(async () => {
+      const ok = await postLogin(srv.url, ALICE);
+      assert.equal(ok.status, 200);
+      tokens.push(JSON.parse(ok.text).token);
+      assert.equal((await postLogin(srv.url, { username: 'alice', password: 'wrong-password-logged' })).status, 401);
+      assert.equal((await postLogin(srv.url, { username: 'carol', password: 'unknown-user-password' })).status, 401);
+      for (let i = 0; i < 5; i++) assert.equal((await postLogin(srv.url, { username: 'bob', password: 'bob-guess-password' })).status, 401);
+      assert.equal((await postLogin(srv.url, { username: 'bob', password: 'bob-guess-password' })).status, 429);
+      assert.equal((await postRaw(srv.url, '{"username":"alice","password":"malformed-body-password"')).status, 400);
+      assert.equal((await postLogin(busy.url, { username: 'alice', password: 'busy-server-password' })).status, 503);
+    });
+    for (const secret of [...secrets, ...tokens]) assert.equal(output.includes(secret), false, 'a secret was written to the logs');
+    assert.equal(output.includes(BOB.password), false);
+  } finally {
+    await srv.close();
+    await busy.close();
+  }
+});
+
+test('the issued token is not logged on a successful login', async () => {
+  const srv = await listen(createServer({ users: createUserStore(USERS) }));
+  try {
+    let token;
+    const output = await recordOutput(async () => {
+      const res = await postLogin(srv.url, ALICE);
+      assert.equal(res.status, 200);
+      token = JSON.parse(res.text).token;
+    });
+    assert.match(token, /^[A-Za-z0-9_-]{43}$/);
+    assert.equal(output.includes(token), false, 'the token was written to the logs');
+  } finally {
+    await srv.close();
+  }
+});
diff --git a/test/login-ratelimit.test.js b/test/login-ratelimit.test.js
new file mode 100644
index 0000000..aecfc70
--- /dev/null
+++ b/test/login-ratelimit.test.js
@@ -0,0 +1,178 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+
+// Count hashPasswordAsync calls (the unknown-user dummy hash) before src/server.js is loaded.
+const usersModule = require('../src/users.js');
+const counters = { hash: 0, verify: 0 };
+const originalHashAsync = usersModule.hashPasswordAsync;
+usersModule.hashPasswordAsync = (...args) => {
+  counters.hash++;
+  return originalHashAsync(...args);
+};
+
+const { createServer } = require('../src/server.js');
+const { createUserStore } = usersModule;
+const { USERS } = require('./fixtures/users.js');
+const { listen } = require('./helpers.js');
+
+const [ALICE, BOB] = USERS;
+const T0 = 1_700_000_000_000;
+const WRONG = { username: 'alice', password: 'wrong-password' };
+
+// src/login.js is loaded lazily so a missing module fails an assertion instead of the whole file.
+function loadLogin() {
+  try {
+    return require('../src/login.js');
+  } catch (err) {
+    if (err.code === 'MODULE_NOT_FOUND') return {};
+    throw err;
+  }
+}
+
+async function postLogin(url, body) {
+  const res = await fetch(`${url}/login`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify(body),
+  });
+  return { status: res.status, headers: res.headers, text: await res.text() };
+}
+
+async function withServer(options, fn) {
+  const clock = { t: T0 };
+  const srv = await listen(createServer({ users: createUserStore(USERS), now: () => clock.t, ...options }));
+  try {
+    await fn(srv, clock);
+  } finally {
+    await srv.close();
+  }
+}
+
+async function failTimes(url, body, n) {
+  for (let i = 0; i < n; i++) assert.equal((await postLogin(url, body)).status, 401, `attempt ${i + 1} is 401`);
+}
+
+test('the 6th attempt after 5 failures is 429 even with the right password', async () => {
+  await withServer({}, async srv => {
+    await failTimes(srv.url, WRONG, 5);
+    const res = await postLogin(srv.url, ALICE);
+    assert.equal(res.status, 429);
+    assert.equal(res.text, '{"error":"too many attempts"}');
+    assert.equal(res.headers.get('retry-after'), '60');
+  });
+});
+
+test('the lock lifts once the oldest failure is 60 seconds old', async () => {
+  await withServer({}, async (srv, clock) => {
+    await failTimes(srv.url, WRONG, 5);
+    clock.t = T0 + 59_999;
+    assert.equal((await postLogin(srv.url, ALICE)).status, 429);
+    clock.t = T0 + 60_000;
+    const res = await postLogin(srv.url, ALICE);
+    assert.equal(res.status, 200);
+    assert.match(JSON.parse(res.text).token, /^[A-Za-z0-9_-]{43}$/);
+  });
+});
+
+test('other usernames are unaffected by a lock', async () => {
+  await withServer({}, async srv => {
+    await failTimes(srv.url, WRONG, 5);
+    const res = await postLogin(srv.url, BOB);
+    assert.equal(res.status, 200);
+    assert.ok(JSON.parse(res.text).token);
+  });
+});
+
+test('unknown usernames are limited exactly like registered ones', async () => {
+  await withServer({}, async srv => {
+    const carol = { username: 'carol', password: 'any-password' };
+    await failTimes(srv.url, carol, 5);
+    assert.equal((await postLogin(srv.url, carol)).status, 429);
+  });
+});
+
+test('a successful login does not reset the failure count', async () => {
+  await withServer({}, async srv => {
+    await failTimes(srv.url, WRONG, 4);
+    assert.equal((await postLogin(srv.url, ALICE)).status, 200);
+    assert.equal((await postLogin(srv.url, WRONG)).status, 401);
+    assert.equal((await postLogin(srv.url, ALICE)).status, 429);
+  });
+});
+
+test('the window slides per failure instead of resetting at once', async () => {
+  await withServer({}, async (srv, clock) => {
+    await failTimes(srv.url, WRONG, 1);
+    clock.t = T0 + 30_000;
+    await failTimes(srv.url, WRONG, 4);
+    let res = await postLogin(srv.url, WRONG);
+    assert.equal(res.status, 429);
+    assert.equal(res.headers.get('retry-after'), '30');
+    clock.t = T0 + 60_000;
+    assert.equal((await postLogin(srv.url, WRONG)).status, 401);
+    res = await postLogin(srv.url, WRONG);
+    assert.equal(res.status, 429);
+    assert.equal(res.headers.get('retry-after'), '30');
+  });
+});
+
+test('a locked username never reaches password verification', async () => {
+  const store = createUserStore(USERS);
+  const users = {
+    has: username => store.has(username),
+    usernames: () => store.usernames(),
+    verifyAsync: (username, password) => {
+      counters.verify++;
+      return store.verifyAsync(username, password);
+    },
+  };
+  await withServer({ users }, async srv => {
+    const before = { ...counters };
+    await failTimes(srv.url, WRONG, 5);
+    await failTimes(srv.url, { username: 'carol', password: 'any-password' }, 5);
+    const locked = { ...counters };
+    assert.equal(locked.verify - before.verify, 5);
+    assert.ok(locked.hash - before.hash >= 5, 'the hashPasswordAsync spy is wired');
+    assert.equal((await postLogin(srv.url, ALICE)).status, 429);
+    assert.equal((await postLogin(srv.url, { username: 'carol', password: 'any-password' })).status, 429);
+    assert.deepEqual(counters, locked);
+  });
+});
+
+test('the limiter tracks at most 10000 usernames via recordFailure', () => {
+  const { createFailureLimiter, MAX_TRACKED } = loadLogin();
+  assert.equal(MAX_TRACKED, 10000);
+  const clock = { t: T0 };
+  const limiter = createFailureLimiter({ now: () => clock.t });
+  for (let i = 0; i < 5; i++) limiter.recordFailure('victim');
+  assert.equal(limiter.check('victim').locked, true);
+  for (let i = 0; i < 9999; i++) limiter.recordFailure(`u${i}`);
+  assert.equal(limiter.size(), 10000);
+  assert.equal(limiter.check('victim').locked, true);
+  limiter.recordFailure('u9999');
+  assert.equal(limiter.size(), 10000);
+  assert.equal(limiter.check('victim').locked, false);
+  clock.t = T0 + 60_000;
+  limiter.recordFailure('late');
+  assert.equal(limiter.size(), 1);
+});
+
+test('the limiter tracks at most 10000 usernames via begin', () => {
+  const { createFailureLimiter, MAX_TRACKED } = loadLogin();
+  assert.equal(MAX_TRACKED, 10000);
+  const limiter = createFailureLimiter({ now: () => T0 });
+  for (let i = 0; i < 5; i++) {
+    assert.equal(limiter.begin('victim').locked, false);
+    limiter.end('victim', true);
+  }
+  assert.equal(limiter.check('victim').locked, true);
+  assert.equal(limiter.size(), 1);
+  for (let i = 0; i < 9999; i++) assert.equal(limiter.begin(`u${i}`).locked, false);
+  assert.equal(limiter.size(), 10000);
+  assert.equal(limiter.check('victim').locked, true);
+  assert.equal(limiter.begin('u9999').locked, false);
+  assert.equal(limiter.size(), 10000);
+  assert.equal(limiter.check('victim').locked, false);
+});
diff --git a/test/login-success.test.js b/test/login-success.test.js
