diff --git a/test/login-concurrency.test.js b/test/login-concurrency.test.js
new file mode 100644
index 0000000..adda0d7
--- /dev/null
+++ b/test/login-concurrency.test.js
@@ -0,0 +1,261 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const crypto = require('node:crypto');
+const usersModule = require('../src/users.js');
+const { createServer } = require('../src/server.js');
+const { USERS } = require('./fixtures/users.js');
+const { listen } = require('./helpers.js');
+
+const { createUserStore } = usersModule;
+const [ALICE, BOB] = USERS;
+const T0 = 1_700_000_000_000;
+const NAMES = Array.from({ length: 40 }, (_, i) => `u${String(i + 1).padStart(2, '0')}`);
+
+// src/login.js is loaded lazily so a missing module fails an assertion instead of the whole file.
+function loadLogin() {
+  try {
+    return require('../src/login.js');
+  } catch (err) {
+    if (err.code === 'MODULE_NOT_FOUND') return {};
+    throw err;
+  }
+}
+
+function newGate() {
+  const { createVerificationGate } = loadLogin();
+  assert.equal(typeof createVerificationGate, 'function', 'src/login.js exports createVerificationGate');
+  return createVerificationGate();
+}
+
+// Polls cond() on every turn of the event loop; fails the test after 2 seconds.
+async function waitFor(cond, label) {
+  const deadline = Date.now() + 2000;
+  while (!cond()) {
+    if (Date.now() > deadline) assert.fail(`timed out waiting for ${label}`);
+    await new Promise(resolve => setImmediate(resolve));
+  }
+}
+
+// A users object whose verifyAsync returns promises the test settles.
+function createSpyUsers() {
+  const names = new Set(['alice', ...NAMES]);
+  const calls = [];
+  const state = { pending: 0, maxPending: 0, auto: null };
+  const settle = (call, outcome) => {
+    if (call.settled) return;
+    call.settled = true;
+    state.pending--;
+    if (outcome instanceof Error) call.reject(outcome);
+    else call.resolve(outcome);
+  };
+  return {
+    calls,
+    state,
+    has: username => names.has(username),
+    usernames: () => [...names],
+    verifyAsync(username, password) {
+      const call = { username, password, settled: false };
+      const promise = new Promise((resolve, reject) => Object.assign(call, { resolve, reject }));
+      calls.push(call);
+      state.pending++;
+      state.maxPending = Math.max(state.maxPending, state.pending);
+      if (state.auto !== null) settle(call, state.auto);
+      return promise;
+    },
+    settle,
+    // Settles every pending call, and every later one, with outcome.
+    settleAll(outcome) {
+      state.auto = outcome;
+      for (const call of calls) settle(call, outcome);
+    },
+  };
+}
+
+function postLogin(url, body, init = {}) {
+  return fetch(`${url}/login`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify(body),
+    ...init,
+  }).then(async res => ({ status: res.status, headers: res.headers, text: await res.text() }));
+}
+
+// Sends one request per username, each only after the previous one is active or queued in the gate.
+async function fillGate(url, gate, usernames) {
+  const responses = [];
+  for (const username of usernames) {
+    const seen = gate.active() + gate.queued();
+    responses.push(postLogin(url, { username, password: `pw-${username}` }));
+    await waitFor(() => gate.active() + gate.queued() === seen + 1, `${username} in the gate`);
+  }
+  return responses;
+}
+
+async function withSpyServer(extra, fn) {
+  const gate = newGate();
+  const users = createSpyUsers();
+  const { createSessionStore } = loadLogin();
+  const srv = await listen(createServer({ users, sessions: createSessionStore(), gate, ...extra }));
+  const pending = [];
+  try {
+    await fn({ srv, gate, users, pending });
+  } finally {
+    users.settleAll(false);
+    await Promise.allSettled(pending);
+    await srv.close();
+  }
+}
+
+test('a login beyond 4 running and 16 waiting gets 503 at once', async () => {
+  await withSpyServer({}, async ({ srv, gate, users, pending }) => {
+    const responses = await fillGate(srv.url, gate, NAMES.slice(0, 20));
+    pending.push(...responses);
+    assert.equal(gate.active(), 4);
+    assert.equal(gate.queued(), 16);
+    assert.equal(users.calls.length, 4);
+    const busy = await postLogin(srv.url, { username: 'u21', password: 'pw-u21' }, { signal: AbortSignal.timeout(2000) });
+    assert.equal(busy.status, 503);
+    assert.equal(busy.headers.get('content-type'), 'application/json');
+    assert.equal(busy.headers.get('retry-after'), '1');
+    assert.equal(busy.text, '{"error":"invalid credentials"}');
+    assert.equal(users.calls.length, 4);
+    assert.equal(gate.queued(), 16);
+    users.settleAll(false);
+    for (const res of await Promise.all(responses)) {
+      assert.equal(res.status, 401);
+      assert.equal(res.text, busy.text);
+    }
+  });
+});
+
+test('at most 4 verifications run and queued logins start in FIFO order', async () => {
+  await withSpyServer({}, async ({ srv, gate, users, pending }) => {
+    const responses = await fillGate(srv.url, gate, NAMES.slice(0, 20));
+    pending.push(...responses);
+    users.settle(users.calls[0], false);
+    await waitFor(() => users.calls.length === 5, 'the 5th verification');
+    assert.equal(users.calls[4].username, 'u05');
+    assert.equal(gate.active(), 4);
+    assert.equal(gate.queued(), 15);
+    users.settleAll(true);
+    const results = await Promise.all(responses);
+    assert.equal(users.state.maxPending, 4);
+    assert.equal(results[0].status, 401);
+    for (const res of results.slice(1)) {
+      assert.equal(res.status, 200);
+      assert.match(JSON.parse(res.text).token, /^[A-Za-z0-9_-]{43}$/);
+    }
+  });
+});
+
+test('503 refusals are not counted as failed attempts', async () => {
+  await withSpyServer({ now: () => T0 }, async ({ srv, gate, users, pending }) => {
+    const responses = await fillGate(srv.url, gate, NAMES.slice(0, 20));
+    pending.push(...responses);
+    for (let i = 0; i < 6; i++) {
+      const res = await postLogin(srv.url, { username: 'alice', password: 'wrong-password' });
+      assert.equal(res.status, 503);
+    }
+    assert.equal(users.calls.some(call => call.username === 'alice'), false);
+    users.settleAll(false);
+    await Promise.all(responses);
+    users.settleAll(true);
+    const res = await postLogin(srv.url, { username: 'alice', password: 'any-password' });
+    assert.equal(res.status, 200);
+    assert.ok(JSON.parse(res.text).token);
+  });
+});
+
+test('the unknown-user dummy hash takes a gate slot', async () => {
+  const gate = newGate();
+  const original = usersModule.hashPasswordAsync;
+  const deferred = [];
+  usersModule.hashPasswordAsync = () => new Promise(resolve => deferred.push(resolve));
+  const srv = await listen(createServer({ users: createUserStore(USERS), gate }));
+  const ghosts = [];
+  let alice;
+  try {
+    for (let i = 1; i <= 4; i++) ghosts.push(postLogin(srv.url, { username: `ghost${i}`, password: 'ghost-password' }));
+    await waitFor(() => deferred.length === 4, '4 dummy hashes');
+    let aliceAnswered = false;
+    alice = postLogin(srv.url, ALICE).then(res => {
+      aliceAnswered = true;
+      return res;
+    });
+    await waitFor(() => gate.queued() === 1, 'alice queued');
+    assert.equal(gate.active(), 4);
+    assert.equal(gate.queued(), 1);
+    assert.equal(aliceAnswered, false);
+    for (const resolve of deferred) resolve(Buffer.alloc(32));
+    for (const res of await Promise.all(ghosts)) assert.equal(res.status, 401);
+    const res = await alice;
+    assert.equal(res.status, 200);
+    assert.ok(JSON.parse(res.text).token);
+  } finally {
+    usersModule.hashPasswordAsync = original;
+    for (const resolve of deferred) resolve(Buffer.alloc(32));
+    await Promise.allSettled([...ghosts, alice]);
+    await srv.close();
+  }
+});
+
+test('a rejected verification answers 500 and frees its slot', async () => {
+  await withSpyServer({}, async ({ srv, gate, users, pending }) => {
+    const first = NAMES.slice(0, 4).map(username => postLogin(srv.url, { username, password: 'pw' }));
+    pending.push(...first);
+    await waitFor(() => users.calls.length === 4, '4 verifications');
+    for (const call of users.calls) users.settle(call, new Error('boom'));
+    for (const res of await Promise.all(first)) {
+      assert.equal(res.status, 500);
+      assert.equal(res.text, '{"error":"internal error"}');
+    }
+    await waitFor(() => gate.active() === 0, 'all slots free');
+    const second = NAMES.slice(4, 8).map(username => postLogin(srv.url, { username, password: 'pw' }));
+    pending.push(...second);
+    await waitFor(() => gate.active() === 4 && users.calls.length === 8, 'the second batch verifying');
+    assert.deepEqual(users.calls.slice(4).map(call => call.username).sort(), NAMES.slice(4, 8));
+    users.settleAll(true);
+    for (const res of await Promise.all(second)) assert.equal(res.status, 200);
+  });
+});
+
+test('concurrent guesses for one username stop at 5 verifications', async () => {
+  await withSpyServer({ now: () => T0 }, async ({ srv, gate, users, pending }) => {
+    const responses = Array.from({ length: 8 }, () => postLogin(srv.url, { username: 'alice', password: 'wrong-password' }));
+    pending.push(...responses);
+    await waitFor(() => gate.active() === 4 && gate.queued() === 4, '4 running and 4 waiting');
+    users.settleAll(false);
+    const results = await Promise.all(responses);
+    assert.equal(users.calls.length, 5);
+    assert.equal(results.filter(res => res.status === 401).length, 5);
+    const locked = results.filter(res => res.status === 429);
+    assert.equal(locked.length, 3);
+    for (const res of locked) assert.equal(res.text, '{"error":"too many attempts"}');
+    assert.equal((await postLogin(srv.url, { username: 'alice', password: 'wrong-password' })).status, 429);
+  });
+});
+
+test('verifyAsync and hashPasswordAsync match the synchronous scheme', async () => {
+  const store = createUserStore(USERS);
+  assert.equal(typeof store.verifyAsync, 'function', 'the store has verifyAsync');
+  assert.equal(typeof usersModule.hashPasswordAsync, 'function', 'src/users.js exports hashPasswordAsync');
+  const cases = [
+    [ALICE.username, ALICE.password, true],
+    [ALICE.username, BOB.password, false],
+    ['carol', ALICE.password, false],
+    [ALICE.username, 12345, false],
+  ];
+  for (const [username, password, expected] of cases) {
+    const result = store.verifyAsync(username, password);
+    assert.ok(result instanceof Promise);
+    assert.equal(await result, expected);
+  }
+  const salt = crypto.randomBytes(16);
+  const asyncHash = await usersModule.hashPasswordAsync('pw', salt);
+  const syncHash = usersModule.hashPassword('pw', salt);
+  assert.ok(Buffer.isBuffer(asyncHash));
+  assert.equal(asyncHash.length, 32);
+  assert.deepEqual(asyncHash, syncHash);
+});
