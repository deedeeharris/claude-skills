{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "feature_id", "spec_sha256", "allowed_paths", "protected_paths", "requirements", "checks"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "feature_id": { "type": "string", "minLength": 1 },
    "spec_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "allowed_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "protected_paths": { "type": "array", "items": { "type": "string" } },
    "state_paths": { "type": "array", "items": { "type": "string" } },
    "clean_ignore": { "type": "array", "items": { "type": "string" } },
    "requirements": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "proof_command"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["runtime", "static"] },
          "proof_command": { "type": "string" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "applicable", "reason"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "applicable": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
