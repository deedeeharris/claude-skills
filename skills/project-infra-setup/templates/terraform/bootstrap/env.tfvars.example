# One file per environment. Apply each one in its OWN project with its OWN local state file:
#   terraform apply -var-file=dev.tfvars  -state=dev.tfstate
#   terraform apply -var-file=prod.tfvars -state=prod.tfstate
# dev.tfvars
project_id        = "REPLACE-dev-project-id"
github_repo       = "REPLACE-owner/REPLACE-repo"
github_repo_id    = "REPLACE-numeric-repo-id"
env               = "dev"
build_and_preview = true # dev only: creates image-pusher and preview-deployer

# prod.tfvars: project_id = the PROD project, env = "prod", build_and_preview omitted (false).
