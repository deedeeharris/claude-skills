index 0000000..ae8fd05
--- /dev/null
+++ b/src/login.js
@@ -0,0 +1,269 @@
+'use strict';
+
+// POST /login: body parsing, validation, the per-username failure limiter, the session store and
+// the server-wide password-verification gate. Nothing here logs: passwords and tokens never reach
+// stdout or stderr.
+
+const crypto = require('node:crypto');
+// Module object, not a destructured function: hashPasswordAsync is read at call time.
+const usersModule = require('./users.js');
+
+const MAX_BODY_BYTES = 4096;
+const MAX_USERNAME_LENGTH = 64;
+const MAX_PASSWORD_LENGTH = 1024;
+const MAX_FAILURES = 5;
+const WINDOW_MS = 60000;
+const MAX_TRACKED = 10000;
+const MAX_ACTIVE_VERIFICATIONS = 4;
+const MAX_QUEUED_VERIFICATIONS = 16;
+const BUSY_RETRY_AFTER_S = 1;
+
+// Unknown usernames are hashed with this salt so they cost the same scrypt work as a real check.
+const DUMMY_SALT = crypto.randomBytes(16);
+
+const INVALID_CREDENTIALS = { error: 'invalid credentials' };
+const TOO_MANY_ATTEMPTS = { error: 'too many attempts' };
+const INVALID_REQUEST = { error: 'invalid request' };
+const PAYLOAD_TOO_LARGE = { error: 'payload too large' };
+const INTERNAL_ERROR = { error: 'internal error' };
+
+function sendJson(res, status, body, headers = {}) {
+  const payload = JSON.stringify(body);
+  res.writeHead(status, { 'content-type': 'application/json', 'content-length': Buffer.byteLength(payload), ...headers });
+  res.end(payload);
+}
+
+// token -> { username, createdAt }; holds at most MAX_TRACKED tokens, evicting the oldest.
+function createSessionStore() {
+  const sessions = new Map();
+  return {
+    issue(username) {
+      const token = crypto.randomBytes(32).toString('base64url');
+      if (sessions.size >= MAX_TRACKED) sessions.delete(sessions.keys().next().value);
+      sessions.set(token, { username, createdAt: Date.now() });
+      return token;
+    },
+    usernameFor(token) {
+      const session = sessions.get(token);
+      return session ? session.username : null;
+    },
+    size() {
+      return sessions.size;
+    },
+  };
+}
+
+// Sliding window per exact username: the newest failure timestamps (at most maxFailures) plus a
+// count of attempts currently in verification. Locked when timestamps + pending >= maxFailures.
+function createFailureLimiter({ maxFailures = MAX_FAILURES, windowMs = WINDOW_MS, maxTracked = MAX_TRACKED, now = Date.now } = {}) {
+  const records = new Map();
+
+  // Drops expired timestamps; deletes and returns null for a record left with nothing in it.
+  function fresh(username, t) {
+    const record = records.get(username);
+    if (!record) return null;
+    record.timestamps = record.timestamps.filter(ts => t - ts < windowMs);
+    if (record.timestamps.length === 0 && record.pending === 0) {
+      records.delete(username);
+      return null;
+    }
+    return record;
+  }
+
+  function status(record, t) {
+    if (!record || record.timestamps.length + record.pending < maxFailures) return { locked: false, retryAfter: 0 };
+    const retryAfter = record.timestamps.length >= maxFailures ? Math.ceil((record.timestamps[0] + windowMs - t) / 1000) : BUSY_RETRY_AFTER_S;
+    return { locked: true, retryAfter };
+  }
+
+  // Returns the record for username, creating it within the maxTracked bound.
+  function track(username, t) {
+    const existing = records.get(username);
+    if (existing) return existing;
+    if (records.size >= maxTracked) {
+      for (const name of [...records.keys()]) fresh(name, t);
+      if (records.size >= maxTracked) records.delete(records.keys().next().value);
+    }
+    const record = { timestamps: [], pending: 0 };
+    records.set(username, record);
+    return record;
+  }
+
+  function recordFailure(username) {
+    const t = now();
+    fresh(username, t);
+    const record = track(username, t);
+    record.timestamps.push(t);
+    if (record.timestamps.length > maxFailures) record.timestamps.splice(0, record.timestamps.length - maxFailures);
+  }
+
+  return {
+    check(username) {
+      const t = now();
+      return status(fresh(username, t), t);
+    },
+    begin(username) {
+      const t = now();
+      const result = status(fresh(username, t), t);
+      if (!result.locked) track(username, t).pending++;
+      return result;
+    },
+    end(username, failed) {
+      const record = records.get(username);
+      if (record && record.pending > 0) record.pending--;
+      if (failed) recordFailure(username);
+    },
+    recordFailure,
+    size() {
+      return records.size;
+    },
+  };
+}
+
+// At most maxActive tasks run at once and at most maxQueued wait in FIFO order; run() returns null
+// when both are full, otherwise a Promise settled with the task's outcome.
+function createVerificationGate({ maxActive = MAX_ACTIVE_VERIFICATIONS, maxQueued = MAX_QUEUED_VERIFICATIONS } = {}) {
+  let running = 0;
+  const queue = [];
+
+  function start({ task, resolve, reject }) {
+    running++;
+    let outcome;
+    try {
+      outcome = Promise.resolve(task());
+    } catch (err) {
+      outcome = Promise.reject(err);
+    }
+    outcome
+      .finally(() => {
+        running--;
+        if (queue.length > 0 && running < maxActive) start(queue.shift());
+      })
+      .then(resolve, reject);
+  }
+
+  return {
+    run(task) {
+      if (running < maxActive) return new Promise((resolve, reject) => start({ task, resolve, reject }));
+      if (queue.length < maxQueued) return new Promise((resolve, reject) => queue.push({ task, resolve, reject }));
+      return null;
+    },
+    active() {
+      return running;
+    },
+    queued() {
+      return queue.length;
+    },
+  };
+}
+
+// Resolves with the body Buffer, or null once it exceeds limit (the rest is discarded).
+function readBody(req, limit) {
+  return new Promise(resolve => {
+    const chunks = [];
+    let size = 0;
+    req.on('data', chunk => {
+      if (size > limit) return;
+      size += chunk.length;
+      if (size > limit) {
+        chunks.length = 0;
+        resolve(null);
+      } else {
+        chunks.push(chunk);
+      }
+    });
+    req.on('end', () => resolve(Buffer.concat(chunks)));
+    req.on('error', () => resolve(null));
+  });
+}
+
+// Returns { username, password } for a valid body, otherwise null.
+function parseCredentials(buffer) {
+  let body;
+  try {
+    body = JSON.parse(buffer.toString('utf8'));
+  } catch {
+    return null;
+  }
+  if (body === null || typeof body !== 'object' || Array.isArray(body)) return null;
+  const { username, password } = body;
+  if (typeof username !== 'string' || username.length < 1 || username.length > MAX_USERNAME_LENGTH) return null;
+  if (typeof password !== 'string' || password.length < 1 || password.length > MAX_PASSWORD_LENGTH) return null;
+  return { username, password };
+}
+
+function sendLocked(res, lock) {
+  sendJson(res, 429, TOO_MANY_ATTEMPTS, { 'retry-after': String(lock.retryAfter) });
+}
+
+function createLoginHandler({ users, sessions, limiter, gate }) {
+  return async function handleLogin(req, res) {
+    const buffer = await readBody(req, MAX_BODY_BYTES);
+    if (buffer === null) {
+      sendJson(res, 413, PAYLOAD_TOO_LARGE, { connection: 'close' });
+      req.resume();
+      return;
+    }
+    const credentials = parseCredentials(buffer);
+    if (!credentials) {
+      sendJson(res, 400, INVALID_REQUEST);
+      return;
+    }
+    const { username, password } = credentials;
+
+    const arrival = limiter.check(username);
+    if (arrival.locked) {
+      sendLocked(res, arrival);
+      return;
+    }
+
+    const verification = gate.run(async () => {
+      const lock = limiter.begin(username);
+      if (lock.locked) return { lock };
+      let ok = false;
+      try {
+        if (users.has(username)) {
+          ok = (await users.verifyAsync(username, password)) === true;
+        } else {
+          await usersModule.hashPasswordAsync(password, DUMMY_SALT);
+        }
+      } catch (err) {
+        limiter.end(username, false);
+        throw err;
+      }
+      limiter.end(username, !ok);
+      return { ok };
+    });
+    if (verification === null) {
+      sendJson(res, 503, INVALID_CREDENTIALS, { 'retry-after': String(BUSY_RETRY_AFTER_S) });
+      return;
+    }
+
+    let result;
+    try {
+      result = await verification;
+    } catch {
+      sendJson(res, 500, INTERNAL_ERROR);
+      return;
+    }
+    if (result.lock) sendLocked(res, result.lock);
+    else if (result.ok) sendJson(res, 200, { token: sessions.issue(username) });
+    else sendJson(res, 401, INVALID_CREDENTIALS);
+  };
+}
+
+module.exports = {
+  MAX_BODY_BYTES,
+  MAX_USERNAME_LENGTH,
+  MAX_PASSWORD_LENGTH,
+  MAX_FAILURES,
+  WINDOW_MS,
+  MAX_TRACKED,
+  MAX_ACTIVE_VERIFICATIONS,
+  MAX_QUEUED_VERIFICATIONS,
+  BUSY_RETRY_AFTER_S,
+  createSessionStore,
+  createFailureLimiter,
+  createVerificationGate,
+  createLoginHandler,
+};
