@@ -0,0 +1,95 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createServer } = require('../src/server.js');
+const { createUserStore } = require('../src/users.js');
+const { USERS } = require('./fixtures/users.js');
+const { listen } = require('./helpers.js');
+
+const [ALICE, BOB] = USERS;
+const TOKEN_RE = /^[A-Za-z0-9_-]{43}$/;
+
+// src/login.js is loaded lazily so a missing module fails an assertion instead of the whole file.
+function loadLogin() {
+  try {
+    return require('../src/login.js');
+  } catch (err) {
+    if (err.code === 'MODULE_NOT_FOUND') return {};
+    throw err;
+  }
+}
+
+function newSessions() {
+  const { createSessionStore } = loadLogin();
+  assert.equal(typeof createSessionStore, 'function', 'src/login.js exports createSessionStore');
+  return createSessionStore();
+}
+
+async function postLogin(url, body) {
+  const res = await fetch(`${url}/login`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body: typeof body === 'string' ? body : JSON.stringify(body),
+  });
+  return { status: res.status, headers: res.headers, text: await res.text() };
+}
+
+test('a correct login returns 200 with a fresh random token each time', async () => {
+  const sessions = newSessions();
+  const srv = await listen(createServer({ users: createUserStore(USERS), sessions }));
+  try {
+    const first = await postLogin(srv.url, ALICE);
+    const second = await postLogin(srv.url, ALICE);
+    for (const res of [first, second]) {
+      assert.equal(res.status, 200);
+      assert.equal(res.headers.get('content-type'), 'application/json');
+      const body = JSON.parse(res.text);
+      assert.deepEqual(Object.keys(body), ['token']);
+      assert.match(body.token, TOKEN_RE);
+    }
+    assert.notEqual(JSON.parse(first.text).token, JSON.parse(second.text).token);
+  } finally {
+    await srv.close();
+  }
+});
+
+test('the session store maps each issued token to its username', async () => {
+  const sessions = newSessions();
+  const srv = await listen(createServer({ users: createUserStore(USERS), sessions }));
+  try {
+    const a = await postLogin(srv.url, ALICE);
+    const b = await postLogin(srv.url, BOB);
+    assert.equal(a.status, 200);
+    assert.equal(b.status, 200);
+    assert.equal(sessions.usernameFor(JSON.parse(a.text).token), 'alice');
+    assert.equal(sessions.usernameFor(JSON.parse(b.text).token), 'bob');
+    assert.equal(sessions.usernameFor('x'.repeat(43)), null);
+  } finally {
+    await srv.close();
+  }
+});
+
+test('the session store holds at most 10000 tokens and evicts the oldest', () => {
+  const sessions = newSessions();
+  const tokens = [];
+  for (let i = 0; i < 10001; i++) tokens.push(sessions.issue('alice'));
+  assert.equal(sessions.size(), 10000);
+  assert.equal(sessions.usernameFor(tokens[0]), null);
+  assert.equal(sessions.usernameFor(tokens[1]), 'alice');
+  assert.equal(sessions.usernameFor(tokens[10000]), 'alice');
+});
+
+test('GET /login falls through to the 404 response', async () => {
+  // Checked first that POST /login is routed, so the 404 below is about the method.
+  const sessions = newSessions();
+  const srv = await listen(createServer({ users: createUserStore(USERS), sessions }));
+  try {
+    assert.equal((await postLogin(srv.url, ALICE)).status, 200);
+    const res = await fetch(`${srv.url}/login`);
+    assert.equal(res.status, 404);
+    assert.deepEqual(await res.json(), { error: 'not found' });
+  } finally {
+    await srv.close();
+  }
+});
