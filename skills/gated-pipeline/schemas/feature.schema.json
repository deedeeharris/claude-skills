{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gated-pipeline:feature:2",
  "title": "gated-pipeline canonical feature file, schema_version 2",
  "description": "docs/v2-design.md section 2. Conditional requirements (\"required when\", \"must be absent\", \"exactly one form\") are graph rules of section 3, not schema keywords.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "title",
    "source_request",
    "coverage",
    "product",
    "architecture",
    "requirements",
    "scope",
    "suite",
    "limits",
    "checks",
    "test_plan"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Exactly one form: { text } or { ref, sha256, summary } (rule G08)."
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "excerpt",
          "disposition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SRC-[0-9]{3}$"
          },
          "excerpt": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "covered",
              "excluded"
            ]
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/requirement_id"
            }
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem",
        "actors",
        "goals",
        "non_goals",
        "constraints",
        "risks",
        "success_metrics"
      ],
      "properties": {
        "problem": {
          "type": "string",
          "minLength": 1
        },
        "actors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "statement",
              "source_ids",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^GOAL-[0-9]{3}$"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/src_id"
                }
              },
              "status": {
                "$ref": "#/$defs/status"
              },
              "retired_rationale": {
                "type": "string"
              }
            }
          }
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "statement",
              "rationale",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^NG-[0-9]{3}$"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "$ref": "#/$defs/status"
              },
              "retired_rationale": {
                "type": "string"
              }
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "success_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approach",
        "decisions",
        "invariants",
        "components",
        "security"
      ],
      "properties": {
        "approach": {
          "type": "string",
          "minLength": 1
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "decision",
              "rationale",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^DEC-[0-9]{3}$"
              },
              "decision": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "$ref": "#/$defs/status"
              },
              "retired_rationale": {
                "type": "string"
              }
            }
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "statement",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^INV-[0-9]{3}$"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "$ref": "#/$defs/status"
              },
              "retired_rationale": {
                "type": "string"
              }
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "description",
              "owned_paths",
              "exclusive",
              "status"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/component_id"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "owned_paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/path"
                }
              },
              "exclusive": {
                "type": "boolean"
              },
              "status": {
                "$ref": "#/$defs/status"
              },
              "retired_rationale": {
                "type": "string"
              }
            }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "data_exposure",
            "input_validation",
            "resource_consumption",
            "accepted_risks"
          ],
          "properties": {
            "data_exposure": {
              "type": "string",
              "minLength": 1
            },
            "input_validation": {
              "type": "string",
              "minLength": 1
            },
            "resource_consumption": {
              "type": "string",
              "minLength": 1
            },
            "accepted_risks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "statement",
                  "cites",
                  "status"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^RISK-[0-9]{3}$"
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cites": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "status": {
                    "$ref": "#/$defs/status"
                  },
                  "retired_rationale": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "goal_ids",
          "statement",
          "priority",
          "depends_on",
          "component_ids",
          "acceptance"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/requirement_id"
          },
          "goal_ids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/goal_id"
            }
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/requirement_id"
            }
          },
          "component_ids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/component_id"
            }
          },
          "derived_rationale": {
            "type": "string"
          },
          "acceptance": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/acceptance"
            }
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "retired_rationale": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_paths",
        "protected_paths",
        "state_paths",
        "clean_ignore",
        "test_paths"
      ],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "protected_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "state_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "clean_ignore": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "test_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "unit_command",
        "known_failures",
        "isolated",
        "setup_command",
        "timeout_min",
        "live_budget_min"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "unit_command": {
          "type": "string",
          "minLength": 1
        },
        "known_failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "test_id",
              "reason"
            ],
            "properties": {
              "test_id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "isolated": {
          "type": "boolean"
        },
        "setup_command": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeout_min": {
          "type": "integer",
          "minimum": 1
        },
        "live_budget_min": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_timeout_s",
        "negative_controls_total_min"
      ],
      "properties": {
        "proof_timeout_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "negative_controls_total_min": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "applicable",
          "reason",
          "budget_min",
          "quiet",
          "effort",
          "environment"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CHECK-[A-Z0-9][A-Z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "applicable": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "expected": {
            "$ref": "#/$defs/expected"
          },
          "timeout_min": {
            "type": "integer",
            "minimum": 1
          },
          "budget_min": {
            "type": "integer",
            "minimum": 0
          },
          "quiet": {
            "type": "boolean"
          },
          "effort": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "environment": {
            "type": "string"
          }
        }
      }
    },
    "test_plan": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "active",
        "retired"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "src_id": {
      "type": "string",
      "pattern": "^SRC-[0-9]{3}$"
    },
    "goal_id": {
      "type": "string",
      "pattern": "^GOAL-[0-9]{3}$"
    },
    "component_id": {
      "type": "string",
      "pattern": "^COMP-[A-Z0-9][A-Z0-9-]*$"
    },
    "requirement_id": {
      "type": "string",
      "pattern": "^(?!(?:GOAL|NG|DEC|INV|SRC|RISK|CHECK|COMP)-)[A-Z][A-Z0-9]*-[0-9]{3}$",
      "description": "<PREFIX>-NNN; PREFIX is not one of the reserved item prefixes."
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Repo-relative; the safety rules are graph rule G32."
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code"
      ],
      "properties": {
        "exit_code": {
          "const": 0
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "given",
        "when",
        "then",
        "verification",
        "negative_control"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}-AC[0-9]+$"
        },
        "given": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "then": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "runtime",
                "static"
              ]
            },
            "live": {
              "type": "boolean"
            },
            "check_id": {
              "type": "string",
              "pattern": "^CHECK-[A-Z0-9][A-Z0-9-]*$"
            },
            "command": {
              "type": "string"
            },
            "expected": {
              "$ref": "#/$defs/expected"
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "paths",
                "description"
              ],
              "properties": {
                "paths": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/path"
                  }
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "negative_control": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "description"
          ],
          "properties": {
            "method": {
              "enum": [
                "isolated_mutation",
                "exempt"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "mutation": {
              "type": "string"
            },
            "exemption_reason": {
              "type": "string"
            },
            "alternate_evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "paths",
                "description"
              ],
              "properties": {
                "paths": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/path"
                  }
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "retired_rationale": {
          "type": "string"
        }
      }
    }
  }
}
