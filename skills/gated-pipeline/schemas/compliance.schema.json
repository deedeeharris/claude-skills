{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings", "requirements"],
  "properties": {
    "verdict": { "type": "string", "enum": ["PASS", "FAIL"] },
    "summary": { "type": "string" },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "NOT_RUN"] },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "head_sha", "command", "exit_code", "log_path", "log_sha256", "file", "line"],
              "properties": {
                "kind": { "type": "string", "enum": ["runtime", "static"] },
                "head_sha": { "type": "string" },
                "command": { "type": ["string", "null"] },
                "exit_code": { "type": ["integer", "null"] },
                "log_path": { "type": ["string", "null"] },
                "log_sha256": { "type": ["string", "null"] },
                "file": { "type": ["string", "null"] },
                "line": { "type": ["integer", "null"] }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "line", "title", "detail", "requirement"],
        "properties": {
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "requirement": { "type": "string" }
        }
      }
    }
  }
}
