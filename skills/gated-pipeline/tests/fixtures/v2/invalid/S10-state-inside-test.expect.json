    "find": "\"allowed_paths\": [\"src/\", \"test/\"], \"protected_paths\": [], \"state_paths\": []",
    "replace": "\"allowed_paths\": [\"src/\"], \"protected_paths\": [], \"state_paths\": [\"test/tmp/\"]"
  },
  "exit": 1,
  "codes": [
    "E_STATE_OVERLAP"
  ],
  "rules": [
    "G34"
  ],
  "paths": [
    "/scope/state_paths/0"
  ],
  "diagnostics": [
    [
      "E_STATE_OVERLAP",
      "G34",
      "/scope/state_paths/0"
    ]
  ],
  "args": {}
}
