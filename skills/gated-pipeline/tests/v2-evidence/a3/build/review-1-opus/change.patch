@@ -0,0 +1,74 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createServer } = require('../src/server.js');
+const { createUserStore } = require('../src/users.js');
+const { USERS } = require('./fixtures/users.js');
+const { listen } = require('./helpers.js');
+
+const [ALICE] = USERS;
+
+async function postRaw(url, body) {
+  const res = await fetch(`${url}/login`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body,
+  });
+  return { status: res.status, text: await res.text() };
+}
+
+test('malformed bodies are rejected with 400', async () => {
+  const srv = await listen(createServer({ users: createUserStore(USERS) }));
+  try {
+    const bodies = [
+      '{"username":"alice",',
+      '[]',
+      JSON.stringify({ username: 'alice' }),
+      JSON.stringify({ username: 1, password: 'x' }),
+      JSON.stringify({ username: '', password: 'x' }),
+      JSON.stringify({ username: 'a'.repeat(65), password: 'x' }),
+      JSON.stringify({ username: 'alice', password: 'p'.repeat(1025) }),
+    ];
+    for (const body of bodies) {
+      const res = await postRaw(srv.url, body);
+      assert.equal(res.status, 400, `400 for ${body.slice(0, 40)}`);
+      assert.equal(res.text, '{"error":"invalid request"}');
+    }
+  } finally {
+    await srv.close();
+  }
+});
+
+test('a body over 4096 bytes is rejected with 413', async () => {
+  const srv = await listen(createServer({ users: createUserStore(USERS) }));
+  try {
+    const body = JSON.stringify({ username: 'alice', password: 'p'.repeat(5000 - 34) });
+    assert.equal(Buffer.byteLength(body), 5000);
+    const res = await postRaw(srv.url, body);
+    assert.equal(res.status, 413);
+    assert.equal(res.text, '{"error":"payload too large"}');
+  } finally {
+    await srv.close();
+  }
+});
+
+test('rejected requests do not count as failed attempts', async () => {
+  const clock = { t: 1_700_000_000_000 };
+  const srv = await listen(createServer({ users: createUserStore(USERS), now: () => clock.t }));
+  try {
+    const bodies = [
+      '{"username":"alice","password":',
+      JSON.stringify({ username: 'alice' }),
+      JSON.stringify({ username: 'alice', password: '' }),
+      JSON.stringify({ username: 'alice', password: 1 }),
+      JSON.stringify({ username: 'alice', password: null }),
+      JSON.stringify({ username: 'alice', password: 'p'.repeat(1025) }),
+    ];
+    for (const body of bodies) assert.equal((await postRaw(srv.url, body)).status, 400);
+    const res = await postRaw(srv.url, JSON.stringify(ALICE));
+    assert.equal(res.status, 200);
+  } finally {
+    await srv.close();
+  }
+});
